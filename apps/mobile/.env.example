# Copy to .env.local. The phone reaches local Supabase over Wi-Fi, so use the PC's LAN IP
# (ipconfig → IPv4 Address), not 127.0.0.1. The key is the Publishable key from `pnpm db:start`.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# The web app, for invitation links (use the LAN IP here too).
EXPO_PUBLIC_WEB_URL=http://192.168.1.10:3000
