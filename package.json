{
  "name": "gravn",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @gravn/web build",
    "dev:web": "pnpm --filter @gravn/web dev",
    "dev:mobile": "pnpm --filter @gravn/mobile start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "gen:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "supabase": "2.119.0"
  }
}
